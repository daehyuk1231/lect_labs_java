import org.springframework.web.bind.annotation.RequestParam;

import app.labs.ex07.fileupload.service.IUploadFileService;
import lombok.extern.slf4j.Slf4j;

@Slf4j
@Controller
public class UploadFileController {

	@Autowired
	IUploadFileService uploadFileService;

	@GetMapping(value = { "/upload/", "/upload" })
	public String getIndex(Model model) {
		return "index";
	}
	
	@GetMapping(value = "/upload/new")
	public String uploadFile(Model model) {
		return "form";
	}
	
	@PostMapping(value = "/upload/new")
	public String uploadFile(@RequestParam(value="dir", rquired=false, defaultValue="/" String dir) Model model) {
		return "form";
	}
}
